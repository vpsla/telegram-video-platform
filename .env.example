# =============================================================================
# Telegram Video Platform — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local            # local | development | staging | production
DEBUG=true
PORT=8000                    # Koyeb injects this automatically in production
LOG_LEVEL=INFO
LOG_DIR=logs
ADMIN_IDS=                   # comma-separated Telegram user IDs, e.g. 123456789,987654321
RATE_LIMIT_PER_MINUTE=20

# --- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890
TELEGRAM_WEBHOOK_BASE_URL=https://your-app.koyeb.app
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_WEBHOOK_SECRET_TOKEN=change-me-to-a-long-random-string

# --- Database (Supabase PostgreSQL) --------------------------------------------
# Use the "Connection Pooling" (transaction mode, port 6543) URI from Supabase
# for the app runtime, and the direct connection (port 5432) for Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# --- Redis (optional, can be enabled later) -------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
